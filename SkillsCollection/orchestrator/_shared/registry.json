{
  "version": "1.0",
  "product": "SkillsCollection AI Manager",
  "skill": {
    "id": "orchestrator",
    "folder": "orchestrator",
    "entry": {"python": "orchestrator/scripts/orchestrator.py"},
    "role": "ai_manager|coordinator|entry_point",
    "accepts": ["folder", "json", "json_file", "stdin", "symptom_text"]
  },
  "delegates": {
    "IIS": {
      "orchestrator": "IIS/orchestrator/scripts/skill_orchestrator.py",
      "registry": "IIS/_shared/registry.json"
    },
    "Edge": {
      "diagnostics": "Edge/edge_diagnostics/scripts/edge_diagnostics.py",
      "orchestrator": "Edge/orchestrator/scripts/edge_orchestrator.py",
      "registry": "Edge/_shared/registry.json"
    }
  },
  "validation": {
    "validator": "Common/log_skills/skills/validator/validator.py",
    "minimum_rounds": 3,
    "minimum_independent_skills": 2
  },
  "report": {
    "schema_version": "1.0",
    "required_sections": [
      "analysis_process",
      "evidence_chain",
      "possible_causes",
      "solutions",
      "missing_logs",
      "invocation_chain"
    ]
  }
}