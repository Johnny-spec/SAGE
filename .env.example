# Copy to .env and fill one provider section. Never commit real secrets.

# Leave empty for the offline deterministic model.
SAGE_AGENT_MODEL=
SAGE_AGENT_TEMPERATURE=0
SAGE_AGENT_MAX_TOKENS=4096
SAGE_AGENT_TIMEOUT_SECONDS=120
SAGE_AGENT_MAX_RETRIES=2
SAGE_AGENT_RECURSION_LIMIT=40

# OpenAI: set SAGE_AGENT_MODEL=openai:<model-name>.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Azure OpenAI v1: set SAGE_AGENT_MODEL=azure_openai:<deployment-name>.
# Authentication can be api-key or entra-id.
SAGE_AZURE_OPENAI_AUTH=api-key
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# OPENAI_API_VERSION is not required by the OpenAI v1 endpoint.

# Entra ID with OpenAI v1 endpoint. No API key is required.
# SAGE_AZURE_OPENAI_AUTH=entra-id
# AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
SAGE_AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default
SAGE_AZURE_OPENAI_CREDENTIAL=default
SAGE_AZURE_OPENAI_TENANT_ID=

# Control plane. Development auto-connects /admin with the shared local token below.
# Production never synthesizes or exposes a token; configure a high-entropy value explicitly.
SAGE_ENVIRONMENT=development
SAGE_REPLICA_COUNT=1
# Disabled by default for development/testing. Set true to re-enable Admin auth.
# Production requires this to be true and refuses to start otherwise.
SAGE_ADMIN_AUTH_ENABLED=false
SAGE_ADMIN_TOKEN=
# Advisory records warnings without blocking activation; required enforces a passing report.
SAGE_EVALUATION_GATE_MODE=advisory
SAGE_CONTROL_DATA_ROOT=.sage-state
SAGE_SKILLS_ROOT=skills
# Optional isolated Python Runner. Configure URL and token together.
SAGE_RUNNER_URL=
SAGE_RUNNER_TOKEN=
SAGE_RUNNER_PROFILE=python-restricted-v1
# Defaults to true only in development without a Runner; production forbids true.
SAGE_ALLOW_LOCAL_SUBPROCESS=
# Public API authentication. Use entra-id in production.
SAGE_AUTHENTICATION_MODE=anonymous
SAGE_ENTRA_TENANT_ID=
SAGE_ENTRA_AUDIENCE=
SAGE_ENTRA_CLIENT_ID=
SAGE_ENTRA_SCOPE=
# Exact browser origins allowed to call the API, comma separated. Never use '*'.
SAGE_CORS_ALLOWED_ORIGINS=
# Optional durable profile. Direct and interactive runs do not require Temporal.
SAGE_TEMPORAL_TARGET=
SAGE_TEMPORAL_NAMESPACE=default
SAGE_TEMPORAL_TASK_QUEUE=sage-workflows
SAGE_TEMPORAL_API_KEY=
SAGE_TEMPORAL_TLS=false
# Optional official LangGraph PostgreSQL checkpointer.
SAGE_CHECKPOINT_DATABASE_URL=
# Runtime Artifact provider. AWS credentials use the standard SDK environment chain.
SAGE_ARTIFACT_BACKEND=local
SAGE_S3_BUCKET=
SAGE_S3_PREFIX=sage
SAGE_S3_ENDPOINT_URL=
SAGE_S3_REGION=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=sage
SAGE_CLAMAV_HOST=
SAGE_CLAMAV_PORT=3310
SAGE_CLAMAV_TIMEOUT_SECONDS=30
# Defaults to true in production and false in development.
SAGE_REQUIRE_CONTENT_SCANNING=
SAGE_SOLUTION_TRUST_STORE=
# Defaults to true in production and false in development.
SAGE_REQUIRE_SIGNED_SOLUTIONS=
SAGE_MCP_ALLOWED_HOSTS=
# Development-only escape hatch. Production always requires this to remain true.
SAGE_MCP_ENFORCE_ALLOWED_HOSTS=true
SAGE_MCP_HEALTH_TTL_SECONDS=900
# JSON object of operator-approved command templates; never accepts request-supplied commands.
SAGE_MCP_STDIO_PRESETS={}
# Dangerous development-only fallback. Keep false outside disposable local environments.
SAGE_ALLOW_PLAINTEXT_DEV_SECRETS=false
# Development only: permits allowlisted HTTP MCP URLs when every DNS result is loopback.
SAGE_ALLOW_INSECURE_LOCAL_MCP=false