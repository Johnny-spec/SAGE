  "CORE_TRIGGER_RULES": [
    {
      "rule_id": "R001",
      "name": "股权控制触发",
      "pattern": {
        "relation_type": "CONTROL",
        "property_conditions": {
          "ratio": ">=0.5"
        }
      },
      "output": {
        "legal_concepts": [
          "股权控制",
          "并表处理"
        ],
        "priority": 10,
        "confidence": 0.95
      },
      "description": "当存在>=50%控制关系时触发股权控制法律概念"
    },
    {
      "rule_id": "R002",
      "name": "国资投资行为触发",
      "pattern": {
        "entity_type": "Company",
        "relation_type": "INVESTS_IN",
        "property_conditions": {
          "is_state_owned": true
        }
      },
      "output": {
        "legal_concepts": [
          "国资投资行为",
          "国资监管"
        ],
        "priority": 9,
        "confidence": 0.9
      },
      "description": "当国有企业投资时触发国资投资行为概念"
    },
    {
      "rule_id": "R003",
      "name": "共建平台决策",
      "pattern": {
        "relation_type": "CO_ESTABLISH"
      },
      "output": {
        "legal_concepts": [
          "三重一大决策",
          "共建治理"
        ],
        "priority": 8,
        "confidence": 0.85
      },
      "description": "共建关系触发三重一大相关规则"
    },
    {
      "rule_id": "R004",
      "name": "大额投资决策",
      "pattern": {
        "relation_type": "INVESTS_IN",
        "property_conditions": {
          "amount": ">50000000"
        }
      },
      "output": {
        "legal_concepts": [
          "重大投资决策",
          "三重一大决策"
        ],
        "priority": 9,
        "confidence": 0.95
      },
      "description": "投资金额≥5000万时触发重大投资决策规则"
    },
    {
      "rule_id": "R005",
      "name": "上市公司关联交易",
      "pattern": {
        "entity_type": "Company",
        "relation_type": "INVESTS_IN",
        "property_conditions": {
          "is_listed": true
        }
      },
      "output": {
        "legal_concepts": [
          "关联交易",
          "信息披露义务"
        ],
        "priority": 10,
        "confidence": 0.9
      },
      "description": "上市公司关联方交易触发披露义务"
    }
