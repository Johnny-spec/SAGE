{
  "version": "1.0",
  "product": "Microsoft Edge (Chromium)",
  "skills": {
    "edge_diagnostics": {
      "folder": "edge_diagnostics",
      "entry": { "python": "edge_diagnostics/scripts/edge_diagnostics.py" },
      "role": "entry_point",
      "needs_admin": false,
      "produces": ["problems", "environment", "skills_to_trigger"],
      "triggers_for": []
    },
    "edge_crash": {
      "folder": "edge_crash",
      "entry": { "python": "edge_crash/scripts/edge_crash_analyzer.py" },
      "role": "follow_up",
      "needs_admin": false,
      "triggers_for": ["crash", "hang", "render_process_gone"]
    },
    "edge_performance": {
      "folder": "edge_performance",
      "entry": { "python": "edge_performance/scripts/edge_performance.py" },
      "role": "follow_up",
      "needs_admin": false,
      "triggers_for": ["slow_startup", "high_cpu", "high_memory", "page_slow"]
    },
    "edge_network": {
      "folder": "edge_network",
      "entry": { "python": "edge_network/scripts/edge_network.py" },
      "role": "follow_up",
      "needs_admin": false,
      "triggers_for": ["page_load_failure", "cert_error", "proxy_issue", "dns_issue", "sync_error"]
    },
    "edge_policy": {
      "folder": "edge_policy",
      "entry": { "python": "edge_policy/scripts/edge_policy.py" },
      "role": "follow_up",
      "needs_admin": false,
      "triggers_for": ["managed_browser", "feature_blocked", "update_blocked", "extension_blocked"]
    },
    "edge_extensions": {
      "folder": "edge_extensions",
      "entry": { "python": "edge_extensions/scripts/edge_extensions.py" },
      "role": "follow_up",
      "needs_admin": false,
      "triggers_for": ["extension_issue", "high_memory", "page_slow"]
    },
    "edge_qa": {
      "folder": "edge_qa",
      "entry": { "python": "edge_qa/scripts/edge_qa.py" },
      "role": "knowledge_base",
      "needs_admin": false,
      "triggers_for": ["question"]
    },
    "edge_known_issue": {
      "folder": "edge_known_issue",
      "entry": { "python": "edge_known_issue/scripts/edge_known_issue.py" },
      "role": "follow_up",
      "needs_admin": false,
      "triggers_for": ["known_issue"]
    },
    "edge_netlog": {
      "folder": "edge_netlog",
      "entry": { "python": "edge_netlog/scripts/edge_netlog.py" },
      "role": "follow_up",
      "needs_admin": false,
      "consumes_log_kind": ["netlog"],
      "triggers_for": ["page_load_failure", "cert_error", "proxy_issue", "dns_issue", "page_slow", "auth_error", "kerberos_spn_mismatch", "auth_handshake_loop"]
    },
    "edge_procmon": {
      "folder": "edge_procmon",
      "entry": { "python": "edge_procmon/scripts/procmon_analyzer.py" },
      "role": "follow_up",
      "needs_admin": false,
      "consumes_log_kind": ["procmon"],
      "triggers_for": []
    },
    "orchestrator": {
      "folder": "orchestrator",
      "entry": { "python": "orchestrator/scripts/edge_orchestrator.py" },
      "role": "product_delegate|compatibility_entry_point",
      "consumes": "edge_diagnostics.output"
    }
  },
  "shared_modules": {
    "python": "_shared/contract.py"
  },
  "agent_workflows": {
    "edge-dump-report": {
      "folder": "edge-dump-report",
      "role": "agent_workflow",
      "requires_mcp_servers": ["WinDbg"],
      "requires_tools": ["WinDbg/*", "read", "search", "edit", "execute"],
      "consumes": ["windbg_session", "dump", "evtx"],
      "produces": ["forensic_markdown_report"],
      "orchestrator_dispatch": false
    }
  },
  "external_registries": [
    "../Common/log_skills/_shared/registry.json"
  ],
  "skill_overrides": {
    "edge_crash": "common_edge_dump_log",
    "edge_netlog": "common_edge_netlog",
    "source_logging_discovery": "common_source_logging_discovery",
    "validator": "common_validator"
  },
  "source_registry": {
    "edge_crash": ["crashpad"],
    "edge_diagnostics": ["crashpad", "registry", "user_data", "processes"],
    "edge_extensions": ["user_data"],
    "edge_known_issue": [],
    "edge_network": ["registry"],
    "edge_netlog": ["netlog"],
    "edge_procmon": ["procmon"],
    "edge_performance": ["processes"],
    "edge_policy": ["registry"],
    "edge_qa": []
  },
  "extra_keys_to_kind": {
    "netlog_paths": "netlog",
    "netlog_folder": "netlog",
    "crashpad_path": "crashpad",
    "evtx_paths": "evtx",
    "evtx_folder": "evtx",
    "procmon_paths": "procmon",
    "procmon_folder": "procmon"
  },
  "cv_config": {
    "enabled": true,
    "minimum_independent_skills": 2,
    "eligible_problem_types": ["crash", "hang", "render_process_gone", "cert_error", "page_load_failure", "high_cpu", "high_memory", "auth_error", "kerberos_spn_mismatch", "auth_handshake_loop"],
    "provider_environment": "SKILLS_VALIDATOR_PROVIDERS_JSON",
    "claude_timeout_seconds": 30,
    "gpt_timeout_seconds": 30,
    "total_validator_timeout_seconds": 90
  },
  "problem_types": {
    "crash":               {"severity_default": "critical", "follow_ups": ["edge_crash", "edge_extensions", "edge_policy", "validator"]},
    "hang":                {"severity_default": "critical", "follow_ups": ["edge_crash", "edge_performance", "edge_extensions", "validator"]},
    "render_process_gone": {"severity_default": "critical", "follow_ups": ["edge_crash", "edge_extensions", "validator"]},
    "slow_startup":        {"severity_default": "warning",  "follow_ups": ["edge_performance", "edge_extensions", "edge_policy"]},
    "high_cpu":            {"severity_default": "warning",  "follow_ups": ["edge_performance", "edge_extensions", "validator"]},
    "high_memory":         {"severity_default": "warning",  "follow_ups": ["edge_performance", "edge_extensions", "validator"]},
    "page_slow":           {"severity_default": "warning",  "follow_ups": ["edge_network", "edge_netlog", "edge_performance"]},
    "page_load_failure":   {"severity_default": "critical", "follow_ups": ["edge_network", "edge_netlog", "edge_policy", "validator"]},
    "cert_error":          {"severity_default": "critical", "follow_ups": ["edge_network", "edge_netlog", "edge_policy", "validator"]},
    "proxy_issue":         {"severity_default": "warning",  "follow_ups": ["edge_network", "edge_netlog", "edge_policy"]},
    "dns_issue":           {"severity_default": "warning",  "follow_ups": ["edge_network", "edge_netlog"]},
    "auth_error":          {"severity_default": "warning",  "follow_ups": ["edge_netlog", "edge_policy", "validator"]},
    "kerberos_spn_mismatch": {"severity_default": "critical", "follow_ups": ["edge_netlog", "validator"]},
    "auth_handshake_loop": {"severity_default": "warning",  "follow_ups": ["edge_netlog", "validator"]},
    "sync_error":          {"severity_default": "warning",  "follow_ups": ["edge_network", "edge_policy"]},
    "update_blocked":      {"severity_default": "warning",  "follow_ups": ["edge_policy"]},
    "extension_issue":     {"severity_default": "warning",  "follow_ups": ["edge_extensions", "edge_policy"]},
    "extension_blocked":   {"severity_default": "info",     "follow_ups": ["edge_policy"]},
    "managed_browser":     {"severity_default": "info",     "follow_ups": ["edge_policy"]},
    "feature_blocked":     {"severity_default": "info",     "follow_ups": ["edge_policy"]},
    "known_issue":         {"severity_default": "warning",  "follow_ups": ["edge_known_issue"]},
    "question":            {"severity_default": "info",     "follow_ups": ["edge_qa"]}
  }
}
